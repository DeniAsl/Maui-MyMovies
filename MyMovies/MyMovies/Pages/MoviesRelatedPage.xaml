<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"  
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"  
            x:Class="MyMovies.Pages.MoviesRelatedPage"  
            xmlns:viewModels="clr-namespace:MyMovies.ViewModels"  
            xmlns:models="clr-namespace:MyMovies.Core.Models"  
            x:DataType="viewModels:MoviesRelatedViewModel"  
            Title="Related">

    <AbsoluteLayout>
        <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All">
            <StackLayout>
                <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="20" Padding="10" Margin="10">
                    <Label
                        x:Name="lblTitle"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        FontSize="Small"
                        FontAttributes="Bold"
                        LineBreakMode="TailTruncation"
                        TextColor="#333">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding SourceMovieTitle, StringFormat='Movies related to: {0}'}" />
                            </FormattedString>
                        </Label.FormattedText>
                        <Label.Shadow>
                            <Shadow Brush="Black" Offset="2,2" Radius="2" />
                        </Label.Shadow>
                    </Label>
                </StackLayout>

                <CollectionView  
                    x:Name="lstMovies"  
                    AbsoluteLayout.LayoutBounds="0,0,1,1"  
                    AbsoluteLayout.LayoutFlags="SizeProportional"  
                    ItemsSource="{Binding Movies}"  
                    SelectionMode="Single"  
                    SelectedItem="{Binding SelectedMovie}">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Movie">
                            <VerticalStackLayout Padding="10">
                                <Image
                                    Source="{Binding CoverImgUrl}"
                                    HeightRequest="200"
                                    Aspect="AspectFit"/>
                                <Label
                                    HorizontalTextAlignment="Center"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Title}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                    <Label.Shadow>
                                        <Shadow Brush="Black" Offset="2,2" Radius="2" />
                                    </Label.Shadow>
                                </Label>
                                <Label
                                    HorizontalTextAlignment="Center">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text=" ⭐" />
                                            <Span Text="{Binding Rating}" />
                                            <Span Text=" • " />
                                            <Span Text="{Binding Runtime, StringFormat='{0} min'}"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                    <Label.Shadow>
                                        <Shadow Brush="Black" Offset="2,2" Radius="2" />
                                    </Label.Shadow>
                                </Label>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>
        </ScrollView>
    </AbsoluteLayout>  
</ContentPage>