<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyMovies.Pages.MoviesRecommendationsPage">
    <VerticalStackLayout>
        <Label 
            Text="Movie recommendations (WIP)"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
            <Button Text="Based on location (Requires GPS permission)"  
                       BackgroundColor="Red"  
                       TextColor="White"  
                       FontAttributes="Bold"  
                       CornerRadius="10"/>
            <Button Text="Random movies"  
                       BackgroundColor="Red"  
                       TextColor="White"  
                       FontAttributes="Bold"  
                       CornerRadius="10" />
            <Button Text="Random To Watch movies"  
                       BackgroundColor="Blue"  
                       TextColor="White"  
                       FontAttributes="Bold"  
                       CornerRadius="10" />
        </HorizontalStackLayout>

    </VerticalStackLayout>
</ContentPage>