<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyMovies.Pages.MoviesSearchPage"
             xmlns:viewModels="clr-namespace:MyMovies.ViewModels"
             xmlns:models="clr-namespace:MyMovies.Core.Models"
             x:DataType="viewModels:MoviesSearchViewModel">
    
    <AbsoluteLayout>
        <ActivityIndicator  
            IsRunning="true"  
            IsVisible="{Binding IsLoading}"  
            Color="Blue"  
            AbsoluteLayout.LayoutBounds="0.5,0.5,AutoSize,AutoSize"  
            AbsoluteLayout.LayoutFlags="PositionProportional" />

        <ScrollView
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All">
            <VerticalStackLayout>
                <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="20" Padding="10" Margin="10">
                    <Label 
                        Text="{Binding Metadata}" 
                        HorizontalOptions="Center" 
                        VerticalOptions="Center" 
                        TextColor="#888" />
                    <Button 
                        Text="Previous" 
                        Command="{Binding PreviousPageCommand}" 
                        IsEnabled="{Binding HasPreviousPage}" 
                        BackgroundColor="#0078D7" 
                        TextColor="White" 
                        CornerRadius="5" 
                        Padding="10,5" />
                    <Label
                        VerticalOptions="Center" 
                        HorizontalOptions="Center" 
                        FontSize="Medium" 
                        FontAttributes="Bold" 
                        TextColor="#333">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding CurrentPage}" />
                                <Span Text=" / " />
                                <Span Text="{Binding TotalPages}" />
                            </FormattedString>
                        </Label.FormattedText>
                        <Label.Shadow>
                            <Shadow Brush="Black" Offset="2,2" Radius="2" />
                        </Label.Shadow>
                    </Label>
                    <Button 
                        Text="Next" 
                        Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding HasNextPage}" 
                        BackgroundColor="#0078D7" 
                        TextColor="White" 
                        CornerRadius="5" 
                        Padding="10,5" />
                    <Picker 
                        Title="Movies per page" 
                        ItemsSource="{Binding MoviesPerPageOptions}" 
                        SelectedItem="{Binding SelectedMoviesPerPage}" 
                        BackgroundColor="#006000" 
                        TextColor="White" 
                        Margin="5,0" />
                    <Picker 
                        Title="Movies per row" 
                        ItemsSource="{Binding MoviesPerRowOptions}" 
                        SelectedItem="{Binding SelectedMoviesPerRow}" 
                        BackgroundColor="#006000" 
                        TextColor="White" 
                        Margin="5,0" />
                </StackLayout>

                <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="20" Padding="10" Margin="10">
                    <SearchBar
                        Text="{Binding SearchQuery}"
                        Placeholder="Search movies..."
                        SearchCommand="{Binding SearchMoviesCommand}"
                        HorizontalOptions="Fill" />
                </StackLayout>

                <CollectionView
                    x:Name="lstMovies"
                    ItemsSource="{Binding Movies}"
                    IsVisible="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"
                    SelectionMode="Single"
                    SelectedItem="{Binding SelectedMovie}">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="{Binding SelectedMoviesPerRow}" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Movie">
                            <Grid Padding="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="200" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Image
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    HorizontalOptions="Center"
                                    Source="{Binding CoverImgUrl}"
                                    HeightRequest="200"
                                    Aspect="AspectFit" />

                                <VerticalStackLayout
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    VerticalOptions="Center"
                                    HorizontalOptions="Center">

                                    <Label
                                        HorizontalTextAlignment="Center"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="1">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Title}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                        <Label.Shadow>
                                            <Shadow Brush="Black" Offset="2,2" Radius="2" />
                                        </Label.Shadow>
                                    </Label>
                                    <Label
                                        HorizontalTextAlignment="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text=" ⭐" />
                                                <Span Text="{Binding Rating}" />
                                                <Span Text=" • " />
                                                <Span Text="{Binding Runtime, StringFormat='{0} min'}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                        <Label.Shadow>
                                            <Shadow Brush="Black" Offset="2,2" Radius="2" />
                                        </Label.Shadow>
                                    </Label>
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </AbsoluteLayout>
</ContentPage>