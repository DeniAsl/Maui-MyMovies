<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyMovies.Pages.MovieDetailsPage"
             xmlns:viewmodels="clr-namespace:MyMovies.ViewModels"
             x:DataType="viewmodels:MovieDetailsViewModel"
             xmlns:models="clr-namespace:MyMovies.Core.Models"
             Title="{Binding SelectedMovie.Title}">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="20">

            <!-- Movie Cover Image -->
            <Image Source="{Binding SelectedMovie.CoverImgUrl}" 
                   Aspect="AspectFill"
                   HeightRequest="300"
                   HorizontalOptions="Center" 
                   WidthRequest="200"/>

            <!-- Movie Title & Year -->
            <Label Text="{Binding SelectedMovie.Title}" 
                   FontSize="24" 
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>
            <Label Text="{Binding SelectedMovie.Year}" 
                   FontSize="18"
                   TextColor="Gray"
                   HorizontalOptions="Center"/>

            <!-- Rating & Runtime -->
            <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                <Label Text="⭐" FontSize="18"/>
                <Label Text="{Binding SelectedMovie.Rating}" FontSize="18"/>
                <Label Text="•" FontSize="18"/>
                <Label Text="{Binding SelectedMovie.Runtime, StringFormat='{0} min'}" FontSize="18"/>
            </HorizontalStackLayout>

            <!-- Genres -->
            <FlexLayout Wrap="Wrap" JustifyContent="Center"
            BindableLayout.ItemsSource="{Binding SelectedMovie.Genres}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="LightGray"
                   CornerRadius="10"
                   Padding="5"
                   Margin="3"
                   HasShadow="False">
                            <Label Text="{Binding .}" TextColor="Black" FontSize="14" Padding="5"/>
                        </Frame>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>


            <!-- Summary -->
            <Label Text="{Binding SelectedMovie.Summary}" 
                   FontSize="14"
                   LineBreakMode="WordWrap"
                   Padding="10"
                   TextColor="White"/>

            <!-- Language -->
            <Label Text="{Binding SelectedMovie.Language, StringFormat='Language: {0}'}"
                   FontSize="14"
                   TextColor="Gray"/>

            <!-- Watch Trailer and Favorite Buttons -->
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">  
               <Button Text="🎬 Watch Trailer"  
                       BackgroundColor="Red"  
                       TextColor="White"  
                       FontAttributes="Bold"  
                       CornerRadius="10"  
                       Command="{Binding OpenTrailerCommand}"/>  
               <Button Text="❤️ Add to Favorite"  
                       BackgroundColor="Blue"
                       TextColor="White"  
                       FontAttributes="Bold"  
                       CornerRadius="10"  
                       Command="{Binding AddToFavoriteCommand}"  
                       CommandParameter="{Binding SelectedMovie}"  
                       IsVisible="{Binding IsFavorite, Converter={StaticResource InverseBooleanConverter}}"/>  
               <Button Text="💔 Remove from Favorite"  
                       BackgroundColor="Blue"  
                       TextColor="White"  
                       FontAttributes="Bold"  
                       CornerRadius="10"  
                       Command="{Binding RemoveFromFavoriteCommand}"  
                       CommandParameter="{Binding SelectedMovie}"  
                       IsVisible="{Binding IsFavorite}"/>
                <Button Text="🔍 Show Related Movies"  
                       BackgroundColor="Green"  
                       TextColor="White"  
                       FontAttributes="Bold"  
                       CornerRadius="10"  
                       Command="{Binding ShowRelatedMovies}"/>
                <Picker Title="Movie State" ItemsSource="{Binding MovieStateOptions}" SelectedItem="{Binding SelectedMovie.MovieState}" />
                <Button Text="🔄 Update Movie State"  
                       BackgroundColor="Chocolate"  
                       TextColor="White"  
                       FontAttributes="Bold"  
                       CornerRadius="10"  
                       Command="{Binding UpdateMovieState}"  
                       CommandParameter="{Binding SelectedMovie}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
