<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyMovies.Pages.MovieDetailsPage"
             xmlns:viewmodels="clr-namespace:MyMovies.ViewModels"
             x:DataType="viewmodels:MovieDetailsViewModel"
             xmlns:models="clr-namespace:MyMovies.Core.Models"
             Title="{Binding SelectedMovie.Title}">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="20">
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="20" >
                <Image Source="{Binding SelectedMovie.CoverImgUrl}" 
                       Aspect="AspectFill"
                       HeightRequest="300"
                       HorizontalOptions="Center" 
                       WidthRequest="200"/>

                <WebView Source="{Binding SelectedMovie.TrailerEmbed}" 
                         HeightRequest="300" 
                         WidthRequest="530" />
            </HorizontalStackLayout>

            <Label Text="{Binding SelectedMovie.Title}" 
                   FontSize="24" 
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>
            <Label Text="{Binding SelectedMovie.Year}" 
                   FontSize="18"
                   TextColor="Gray"
                   HorizontalOptions="Center"/>

            <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                <Label Text="⭐" FontSize="18"/>
                <Label Text="{Binding SelectedMovie.Rating}" FontSize="18"/>
                <Label Text="•" FontSize="18"/>
                <Label Text="{Binding SelectedMovie.Runtime, StringFormat='{0} min'}" FontSize="18"/>
            </HorizontalStackLayout>

            <FlexLayout Wrap="Wrap" JustifyContent="Center"
                BindableLayout.ItemsSource="{Binding SelectedMovie.Genres}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="LightGray"
                               CornerRadius="10"
                               Padding="5"
                               Margin="3"
                               HasShadow="False">
                              <Label Text="{Binding .}" TextColor="Black" FontSize="14" Padding="5"/>
                        </Frame>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <Label Text="{Binding SelectedMovie.Summary}" 
                   FontSize="14"
                   LineBreakMode="WordWrap"
                   Padding="10"
                   TextColor="White"/>

            <Label Text="{Binding SelectedMovie.Language, StringFormat='Language: {0}'}"
                   FontSize="14"
                   TextColor="Gray"/>

            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">  
               <Button Text="🎬 Watch Trailer"  
                       BackgroundColor="Red"  
                       TextColor="White"  
                       FontAttributes="Bold"  
                       CornerRadius="10"  
                       Command="{Binding OpenTrailerCommand}"/>  
               <Button Text="❤️ Add to Favorite"  
                       BackgroundColor="Blue"
                       TextColor="White"  
                       FontAttributes="Bold"  
                       CornerRadius="10"  
                       Command="{Binding AddToFavoriteCommand}"  
                       CommandParameter="{Binding SelectedMovie}"  
                       IsVisible="{Binding IsFavorite, Converter={StaticResource InverseBooleanConverter}}"/>  
               <Button Text="💔 Remove from Favorite"  
                       BackgroundColor="Blue"  
                       TextColor="White"  
                       FontAttributes="Bold"  
                       CornerRadius="10"  
                       Command="{Binding RemoveFromFavoriteCommand}"  
                       CommandParameter="{Binding SelectedMovie}"  
                       IsVisible="{Binding IsFavorite}"/>
                <Button Text="🔍 Show Related Movies"  
                       BackgroundColor="Green"  
                       TextColor="White"  
                       FontAttributes="Bold"  
                       CornerRadius="10"  
                       Command="{Binding ShowRelatedMovies}"/>
                <Picker 
                        Title="Movie state" 
                        ItemsSource="{Binding MovieStateOptions}" 
                        SelectedItem="{Binding SelectedMovie.MovieState}" 
                        BackgroundColor="#006000" 
                        TextColor="White" />
                <Button Text="🔄 Update Movie State"  
                       BackgroundColor="Chocolate"  
                       TextColor="White"  
                       FontAttributes="Bold"  
                       CornerRadius="10"  
                       Command="{Binding UpdateMovieState}"  
                       CommandParameter="{Binding SelectedMovie}" />
                <Button Text="🔄 View Movie Sources"  
                       BackgroundColor="Chocolate"  
                       TextColor="White"  
                       FontAttributes="Bold"  
                       CornerRadius="10"  
                       Command="{Binding ShowSourcesCommand}"  
                       CommandParameter="{Binding SelectedMovie.ImdbCode}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
