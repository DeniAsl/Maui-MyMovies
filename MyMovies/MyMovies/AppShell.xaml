<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MyMovies.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:MyMovies.Pages"
    Shell.FlyoutBehavior="Flyout"
    Title="My Movies">
    <FlyoutItem Title="Movies" Route="Movies">
        <ShellContent
            Title="Latest"
            ContentTemplate="{DataTemplate pages:MoviesListPage}"
            Route="MoviesListPage" />
    </FlyoutItem>
    <FlyoutItem Title="Search" Route="Search">
        <ShellContent
            Title="Search"
            ContentTemplate="{DataTemplate pages:MoviesSearchPage}"
            Route="MoviesSearchPage" />
    </FlyoutItem>
    <FlyoutItem Title="Favorites" Route="Favorites">
        <ShellContent
            Title="Favorites"
            ContentTemplate="{DataTemplate pages:MoviesFavoritesPage}"
            Route="MoviesFavoritesPage" />
    </FlyoutItem>
    <FlyoutItem Title="Recommendations" Route="Recommendations">
        <ShellContent
            Title="Recommendations"
            ContentTemplate="{DataTemplate pages:MoviesRecommendationsPage}"
            Route="MoviesRecommendationsPage" />
    </FlyoutItem>
    <FlyoutItem Title="Settings" Route="Settings">
        <ShellContent
            Title="Settings"
            ContentTemplate="{DataTemplate pages:SettingsPage}"
            Route="SettingsPage" />
    </FlyoutItem>
</Shell>
